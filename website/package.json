{
  "name": "chengying-website",
  "private": true,
  "version": "0.8.0",
  "description": "澄影 Chengying 官方网站 — 面向摄影爱好者的智能选片与自然光影精修助手（DeepSeek Harness 插件）",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "assets": "node scripts/build-photo-assets.mjs",
    "verify": "node scripts/verify-website.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.65.1",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
