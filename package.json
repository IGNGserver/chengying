{
  "name": "chengying",
  "version": "0.2.0",
  "description": "澄影 Chengying: AI photo culling and professional retouching agent workflow for DeepSeek Harness",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "native",
    "catalogs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "bin": {
    "chengying": "./lib/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:engines": "vitest run --config vitest.engines.config.ts",
    "test:dsh": "vitest run --config vitest.dsh.config.ts",
    "coverage:interfaces": "node lib/cli.js engines list"
  },
  "dependencies": {
    "exiftool-vendored": "^39.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "esbuild": "^0.25.9",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^19.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": false
    }
  }
}
